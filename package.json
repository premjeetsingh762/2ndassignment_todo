{
  "name": "pdf-text-modifier",
  "version": "1.0.0",
  "description": "A comprehensive tool for modifying text in PDF files",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm start --prefix client",
    "build": "npm run build --prefix client",
    "install-deps": "npm install && npm install --prefix client"
  },
  "keywords": [
    "pdf",
    "text",
    "modification",
    "extraction",
    "nodejs",
    "react"
  ],
  "author": "PDF Text Modifier",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}